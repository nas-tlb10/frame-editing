# Clé Anthropic — à créer sur https://console.anthropic.com/settings/keys
# Ne jamais committer ce fichier.
ANTHROPIC_API_KEY=

# Modèle de planification (défaut : claude-opus-5-5)
# FRAME_PLAN_MODEL=claude-opus-5-5

# "mock" force un plan de secours déterministe, sans appel API.
# FRAME_PLAN_MODE=mock
